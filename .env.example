APP_NAME=SyntaxCore
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

# Database Configuration
# When running with Docker Compose: DB_HOST=db (managed automatically in docker-compose.yml)
# When running on host machine directly: DB_HOST=127.0.0.1
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=syntaxcore
DB_USERNAME=syntaxcore
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
FORWARD_DB_PORT=3306

# Seeder Credentials (Development only)
# Used by database/seed.php to populate default administrator
SEED_ADMIN_EMAIL=admin@syntaxcore.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Administrator
